FROM python:3.11-slim 
# тут выбираем образ, тот самый image, slim это специальная урезанная версия

WORKDIR /app 
# создаем рабочую директорию внутри контейнера, которая будет называться app

COPY . . 
# копируем весь код в контейнер

CMD ["python", "main.py"] 
# при запуске контейнера выполнится команда python main.py
